@model ForgotPasswordVm
@{
    Layout = null;
}
<!doctype html>
<html lang="ru">
    <head>
        <meta charset="utf-8"/>
        <meta name="viewport" content="width=device-width,initial-scale=1"/>
        <title>Восстановление пароля — FitMind</title>
        <link rel="stylesheet" href="/css/site.css"/>
        <link rel="stylesheet" href="/css/refinement.css" asp-append-version="true" />
        <link rel="stylesheet" href="/css/public-pages.css" asp-append-version="true" />
    </head>
    <body class="auth-v04-page">
        <a class="auth-v04-logo" href="/">
            <svg aria-hidden="true" class="fm-icon auth-v04-logo-icon">
                <use href="/icons/fitmind-icons.svg#logo">
                </use>
            </svg>
            <b>Fit<span>Mind</span>
        </b>
    </a>
    <main class="auth-v04-wrap">
        <form asp-action="ForgotPassword" method="post" class="auth-v04-card auth-v04-login-card">
            <div class="auth-v04-title">
                <h1>Восстановление пароля</h1>
                <p>Укажи email аккаунта, чтобы запросить ссылку для сброса пароля.</p>
            </div>
            @if(TempData["Error"]!=null){
                <div class="validation">@TempData["Error"]</div>
            }
            @if(ViewBag.Message!=null){
                <div class="toast" role="status">@ViewBag.Message</div>
            }
            <div asp-validation-summary="All" class="validation" role="alert" tabindex="-1">
            </div>
            <label class="auth-v04-field">
                <span>Email</span>
                <span class="auth-v04-input">
                    <svg aria-hidden="true" class="fm-icon">
                        <use href="/icons/fitmind-icons.svg#mail">
                        </use>
                    </svg>
                    <input asp-for="Email" autocomplete="email" placeholder="Введите ваш email..." />
                </span>
                <span asp-validation-for="Email" class="validation">
                </span>
            </label>
            <button class="auth-v04-primary" type="submit">Запросить ссылку <span aria-hidden="true">→</span>
        </button>
        <p class="auth-v04-bottom">
            <a asp-action="Login">← Вернуться ко входу</a>
        </p>
    </form>
</main>
<script src="/js/site.js" asp-append-version="true">
</script>
</body>
</html>
