@model RegisterVm
@using Microsoft.AspNetCore.Authentication
@{
    Layout = null;
    var providers = ViewBag.ExternalProviders as AuthenticationScheme[] ?? Array.Empty<AuthenticationScheme>();
}
<!doctype html>
<html lang="ru">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>Регистрация — FitMind</title>
        <link rel="stylesheet" href="/css/site.css" />
        <link rel="stylesheet" href="/css/refinement.css"/>
        <link rel="stylesheet" href="/css/public-pages.css" asp-append-version="true" />
    </head>
    <body class="auth-v04-page">
        <a class="auth-v04-logo" href="/" aria-label="FitMind">
            <svg aria-hidden="true" class="fm-icon auth-v04-logo-icon">
                <use href="/icons/fitmind-icons.svg#logo">
                </use>
            </svg>
            <b>Fit<span>Mind</span>
        </b>
    </a>
    <main class="auth-v04-wrap">
        <form asp-action="Register" method="post" class="auth-v04-card">
            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
            <div class="auth-v04-title">
                <h1>Создание <span>аккаунта</span>
            </h1>
            <p>Начни путь к своей лучшей форме вместе с FitMind</p>
        </div>
        <div asp-validation-summary="All" class="validation" role="alert" tabindex="-1">
        </div>
        <label class="auth-v04-field">
            <span>Имя</span>
            <span class="auth-v04-input">
                <svg aria-hidden="true" class="fm-icon">
                    <use href="/icons/fitmind-icons.svg#user">
                    </use>
                </svg>
                <input asp-for="Name" placeholder="Как к тебе обращаться?" autocomplete="name" />
            </span>
            <span asp-validation-for="Name" class="validation">
            </span>
        </label>
        <label class="auth-v04-field">
            <span>Email</span>
            <span class="auth-v04-input">
                <svg aria-hidden="true" class="fm-icon">
                    <use href="/icons/fitmind-icons.svg#mail">
                    </use>
                </svg>
                <input asp-for="Email" placeholder="Твой email" autocomplete="email" />
            </span>
            <span asp-validation-for="Email" class="validation">
            </span>
        </label>
        <label class="auth-v04-field">
            <span>Пароль</span>
            <span class="auth-v04-input">
                <svg aria-hidden="true" class="fm-icon">
                    <use href="/icons/fitmind-icons.svg#lock">
                    </use>
                </svg>
                <input asp-for="Password" aria-describedby="password-requirements" placeholder="Создай надёжный пароль" autocomplete="new-password" />
                <button type="button" class="password-toggle" aria-pressed="false" aria-label="Показать пароль">
                    <svg aria-hidden="true" class="fm-icon">
                        <use href="/icons/fitmind-icons.svg#eye">
                        </use>
                    </svg>
                </button>
            </span>
            <small id="password-requirements">Минимум 8 символов</small>
            <span asp-validation-for="Password" class="validation">
            </span>
        </label>
        <label class="auth-v04-field">
            <span>Повторите пароль</span>
            <span class="auth-v04-input">
                <svg aria-hidden="true" class="fm-icon">
                    <use href="/icons/fitmind-icons.svg#lock">
                    </use>
                </svg>
                <input asp-for="ConfirmPassword" placeholder="Введите пароль ещё раз" autocomplete="new-password" />
                <button type="button" class="password-toggle" aria-pressed="false" aria-label="Показать пароль">
                    <svg aria-hidden="true" class="fm-icon">
                        <use href="/icons/fitmind-icons.svg#eye">
                        </use>
                    </svg>
                </button>
            </span>
            <span asp-validation-for="ConfirmPassword" class="validation">
            </span>
        </label>
        <button class="auth-v04-primary" type="submit">Создать аккаунт <span>→</span>
    </button>
    @if (providers.Length > 0) { <div class="auth-v04-separator">
    <span>
    </span>
    <em>или</em>
    <span>
    </span>
</div> }
@foreach (var provider in providers)
{
<button class="auth-v04-google" type="submit" formnovalidate asp-action="ExternalLogin" asp-route-returnUrl="@ViewBag.ReturnUrl" name="provider" value="@provider.Name">
    <img class="google-icon" src="/icons/google.svg" alt="" width="20" height="20" /> Продолжить через @provider.DisplayName</button>
}

<p class="auth-v04-bottom">Уже есть аккаунт? <a asp-action="Login">Войти</a>
</p>
</form>
</main>
<script src="/js/site.js"></script></body>
</html>
