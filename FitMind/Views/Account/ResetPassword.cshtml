@model ResetPasswordVm
@{
    Layout = null;
}
<!doctype html>
<html lang="ru">
    <head>
        <meta charset="utf-8"/>
        <meta name="viewport" content="width=device-width,initial-scale=1"/>
        <title>Новый пароль — FitMind</title>
        <link rel="stylesheet" href="/css/site.css"/>
        <link rel="stylesheet" href="/css/refinement.css" asp-append-version="true" />
        <link rel="stylesheet" href="/css/public-pages.css" asp-append-version="true" />
    </head>
    <body class="auth-v04-page">
        <a class="auth-v04-logo" href="/">
            <svg aria-hidden="true" class="fm-icon auth-v04-logo-icon">
                <use href="/icons/fitmind-icons.svg#logo">
                </use>
            </svg>
            <b>Fit<span>Mind</span>
        </b>
    </a>
    <main class="auth-v04-wrap">
        <form asp-action="ResetPassword" method="post" class="auth-v04-card auth-v04-login-card">
            <div class="auth-v04-title">
                <h1>Новый пароль</h1>
                <p>Задай новый пароль для аккаунта FitMind.</p>
            </div>
            <input asp-for="Email" type="hidden"/>
            <input asp-for="Token" type="hidden"/>
            <div asp-validation-summary="All" class="validation" role="alert" tabindex="-1">
            </div>
            <p id="password-requirements" class="auth-v04-bottom">Минимум 8 символов</p>
            <label class="auth-v04-field">
                <span>Новый пароль</span>
                <span class="auth-v04-input">
                    <svg aria-hidden="true" class="fm-icon">
                        <use href="/icons/fitmind-icons.svg#lock">
                        </use>
                    </svg>
                    <input asp-for="Password" aria-describedby="password-requirements" autocomplete="new-password" placeholder="Минимум 8 символов" />
                    <button type="button" class="password-toggle" aria-label="Показать пароль" aria-pressed="false">
                        <svg class="fm-icon" aria-hidden="true">
                            <use href="/icons/fitmind-icons.svg#eye">
                            </use>
                        </svg>
                    </button>
                </span>
                <span asp-validation-for="Password" class="validation">
                </span>
            </label>
            <label class="auth-v04-field">
                <span>Повторите пароль</span>
                <span class="auth-v04-input">
                    <svg aria-hidden="true" class="fm-icon">
                        <use href="/icons/fitmind-icons.svg#lock">
                        </use>
                    </svg>
                    <input asp-for="ConfirmPassword" autocomplete="new-password" placeholder="Введите пароль ещё раз" />
                    <button type="button" class="password-toggle" aria-label="Показать пароль" aria-pressed="false">
                        <svg class="fm-icon" aria-hidden="true">
                            <use href="/icons/fitmind-icons.svg#eye">
                            </use>
                        </svg>
                    </button>
                </span>
                <span asp-validation-for="ConfirmPassword" class="validation">
                </span>
            </label>
            <button class="auth-v04-primary" type="submit">Сохранить пароль <span>→</span>
        </button>
        <p class="auth-v04-bottom">
            <a asp-action="Login">Вернуться ко входу</a>
        </p>
        <p class="auth-v04-bottom">
            <a asp-action="ForgotPassword">Запросить новую ссылку</a>
        </p>
    </form>
</main>
<script src="/js/site.js" asp-append-version="true">
</script>
</body>
</html>
