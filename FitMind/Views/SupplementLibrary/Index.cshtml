@model IEnumerable<Supplement>
@{
    ViewData["Title"]="Добавки";
    var cats=(IEnumerable<Category>)ViewBag.Categories;
}
<div class="page-head">
    <div>
        <h1>Добавки</h1>
        <p>Информационная база спортивных добавок, витаминов и тонизирующих продуктов. Пользователь её не изменяет.</p>
    </div>
</div>
<div asp-validation-summary="All" class="validation">
</div>
<form method="get" class="filterbar library-filter">
    <input name="q" value="@ViewBag.Q" placeholder="Поиск добавок..."/>
    <select name="categoryId" data-current="@ViewBag.CategoryId">
        <option value="">Все категории</option>
        @foreach(var c in cats){
            <option value="@c.Id">@c.Name</option>
        }
    </select>
    <select name="sort" data-current="@Context.Request.Query["sort"]">
        <option value="">По названию</option>
        <option value="category">По категории</option>
    </select>
    <button class="primary">Найти</button>
</form>
@if(!Model.Any()){
    <section class="empty-state">
        <div class="empty-icon">
            <svg class="fm-icon" aria-hidden="true">
                <use href="/icons/fitmind-icons.svg#supplement">
                </use>
            </svg>
        </div>
        <h2>Добавки не найдены</h2>
        <p>Измени фильтры или выполни поиск по другому названию.</p>
        <a class="ghost" asp-action="Index">Сбросить фильтры</a>
    </section>
}else{<div class="library-grid">
@foreach(var x in Model){
    <article class="library-card">
        <catalog-placeholder kind="Supplements" alt="Иллюстрация раздела «Добавки»">
        </catalog-placeholder>
        <div class="library-card-body">
            <span class="pill">@x.Category?.Name</span>
            <h3>@x.Name</h3>
            <p>@x.ShortDescription</p>
            <a asp-action="Details" asp-route-id="@x.Id" class="ghost full">Подробнее</a>
        </div>
    </article>
}
</div>
}
<partial name="_Pagination" model="(FitMind.ViewModels.PaginationVm)ViewBag.Pagination" />
