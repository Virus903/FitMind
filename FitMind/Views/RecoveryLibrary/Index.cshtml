@model IEnumerable<RecoveryMethod>
@{
    ViewData["Title"]="Сон и восстановление";
    var cats=(IEnumerable<string>)ViewBag.Categories;
}
<div class="page-head">
    <div>
        <h1>Сон и восстановление</h1>
        <p>Справочная база FitMind: сон, отдых и методы восстановления. Общую базу пользователь не редактирует.</p>
    </div>
</div>
<div asp-validation-summary="All" class="validation">
</div>
<form method="get" class="filterbar library-filter">
    <input name="q" value="@ViewBag.Q" placeholder="Поиск материалов..."/>
    <select name="category" data-current="@ViewBag.Category">
        <option value="">Все категории</option>
        @foreach(var c in cats){
            <option>@c</option>
        }
    </select>
    <select name="sort" data-current="@Context.Request.Query["sort"]">
        <option value="">По названию</option>
        <option value="duration">По длительности</option>
    </select>
    <button class="primary">Применить</button>
</form>
@if(!Model.Any()){
    <section class="empty-state">
        <div class="empty-icon">
            <svg class="fm-icon" aria-hidden="true">
                <use href="/icons/fitmind-icons.svg#moon">
                </use>
            </svg>
        </div>
        <h2>Материалы не найдены</h2>
        <p>Попробуй изменить запрос или фильтры.</p>
        <a class="ghost" asp-action="Index">Сбросить фильтры</a>
    </section>
}else{<div class="library-grid">
@foreach(var x in Model){
    <article class="library-card">
        <catalog-placeholder kind="Recovery" alt="Иллюстрация раздела «Методы восстановления»">
        </catalog-placeholder>
        <div class="library-card-body">
            <span class="pill">@x.Category</span>
            <h3>@x.Name</h3>
            <p>@x.ShortDescription</p>
            <div class="library-meta">
                <span>@(x.MinMinutes?.ToString()??"—")–@(x.MaxMinutes?.ToString()??"—") мин.</span>
            </div>
            <a asp-action="Details" asp-route-id="@x.Id" class="ghost full">Подробнее</a>
        </div>
    </article>
}
</div>
}
<partial name="_Pagination" model="(FitMind.ViewModels.PaginationVm)ViewBag.Pagination" />
