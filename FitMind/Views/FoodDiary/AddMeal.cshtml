@model MealEditVm
@using FitMind.Models
@{
    ViewData["Title"]="Записать питание или воду";
    var products=(IEnumerable<FoodProduct>)ViewBag.Products;
}
<div class="page-head">
    <div>
        <a asp-action="Index" class="text-link">← Питание и вода</a>
        <h1>Записать</h1>
        <p>Выбери приём пищи или воду — форма покажет только нужные поля.</p>
    </div>
</div>
<form asp-action="AddMeal" method="post" class="form-card" id="food-entry-form">
    <div asp-validation-summary="All" class="validation">
    </div>
    <div class="choice-cards choice-cards--two">
        <label class="choice-card">
            <input asp-for="Type" type="radio" value="@ProgramItemType.Meal"/>
            <span>Приём пищи</span>
        </label>
        <label class="choice-card">
            <input asp-for="Type" type="radio" value="@ProgramItemType.Water"/>
            <span>Вода</span>
        </label>
    </div>
    <div class="form-grid two">
        <label>Дата<input asp-for="Date" type="date"/>
    </label>
    <label>Время<input asp-for="Time" type="time"/>
</label>
</div>
<label>Название<input asp-for="Name" placeholder="Например: Обед или зелёный чай"/>
</label>
<section data-entry-kind="meal">
    <label>Продукт или рецепт<select asp-for="ProductId">
    <option value="">Ввести вручную</option>
    @foreach(var p in products){
        <option value="@p.Id">@p.Name · @(p.Kind==FoodProductKind.Recipe?"рецепт":"продукт") · @p.Calories.ToString("0") ккал/100 г</option>
    }
</select>
</label>
<label>Своё название<input asp-for="CustomName"/>
</label>
<div class="form-grid five">
    <label>Граммы<input asp-for="Grams" type="number" min="1" max="5000"/>
</label>
<label>Ккал/100 г<input asp-for="CaloriesPer100" type="number" step="0.1" min="0"/>
</label>
<label>Белки<input asp-for="ProteinPer100" type="number" step="0.1" min="0"/>
</label>
<label>Жиры<input asp-for="FatPer100" type="number" step="0.1" min="0"/>
</label>
<label>Углеводы<input asp-for="CarbsPer100" type="number" step="0.1" min="0"/>
</label>
</div>
</section>
<section data-entry-kind="water">
    <label>Объём, мл<input name="Grams" value="@Model.Grams.ToString("0")" type="number" min="1" max="10000" step="50"/>
</label>
<div class="quick-water">
    <button type="button" data-water="250">250 мл</button>
    <button type="button" data-water="500">500 мл</button>
    <button type="button" data-water="750">750 мл</button>
</div>
</section>
<label>Комментарий<textarea asp-for="Comment" rows="3"></textarea></label>
<div class="form-actions">
    <a asp-action="Index" class="ghost">Отмена</a>
    <button class="primary">Сохранить</button>
</div>
</form>
@section Scripts{<script>const syncEntry=()=>{const water=document.querySelector('[name="Type"]:checked')?.value==='Water'||document.querySelector('[name="Type"]:checked')?.value==='2';const meal=document.querySelector('[data-entry-kind="meal"]');const drink=document.querySelector('[data-entry-kind="water"]');meal.hidden=water;drink.hidden=!water;meal.querySelectorAll('input,select,textarea').forEach(x=>x.disabled=water);drink.querySelectorAll('input,select,textarea').forEach(x=>x.disabled=!water)};document.querySelectorAll('[name="Type"]').forEach(x=>x.addEventListener('change',syncEntry));document.querySelectorAll('[data-water]').forEach(x=>x.addEventListener('click',()=>document.querySelector('[data-entry-kind="water"] [name="Grams"]').value=x.dataset.water));syncEntry();</script>}
