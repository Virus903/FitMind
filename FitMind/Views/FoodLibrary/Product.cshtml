@model FoodProduct
@{
    ViewData["Title"]=Model.Name;
}
<a asp-action="Index" class="back">← Назад к продуктам</a>
<div class="detail-hero catalog-detail-hero">
    <catalog-placeholder kind="Food" alt="Иллюстрация раздела «Продукты и рецепты»">
    </catalog-placeholder>
    <div>
        <span class="pill">@Model.Category?.Name</span>
        <h1>@Model.Name</h1>
        <p>@Model.Description</p>
        <div class="macro-cards">
            <div>
                <small>Калории</small>
                <b>@Model.Calories ккал</b>
            </div>
            <div>
                <small>Белки</small>
                <b>@Model.Protein г</b>
            </div>
            <div>
                <small>Жиры</small>
                <b>@Model.Fat г</b>
            </div>
            <div>
                <small>Углеводы</small>
                <b>@Model.Carbs г</b>
            </div>
        </div>
        <div class="detail-actions">
            <div asp-validation-summary="All" class="validation">
            </div>
            <form asp-controller="FoodDiary" asp-action="AddProductFromBase" method="post">
                <input type="hidden" name="id" value="@Model.Id"/>
                <button class="primary">Добавить в моё питание</button>
            </form>
            <a asp-action="AddProductToDiary" asp-route-id="@Model.Id" class="ghost">Добавить сразу в дневник</a>
        </div>
    </div>
</div>
<div class="detail-sections">
    <section class="detail-card">
        <h2>Польза</h2>
        <p class="preline">@Model.Benefits</p>
    </section>
    <section class="detail-card">
        <h2>Советы по приготовлению</h2>
        <p class="preline">@Model.CookingTips</p>
    </section>
    <section class="detail-card">
        <h2>Дополнительно</h2>
        <div class="data-line">
            <span>Порция</span>
            <b>@(Model.ServingGrams??100) г</b>
        </div>
        <div class="data-line">
            <span>Клетчатка</span>
            <b>@(Model.Fiber?.ToString()??"—") г</b>
        </div>
        <div class="data-line">
            <span>Гликемический индекс</span>
            <b>@(Model.GlycemicIndex?.ToString()??"—")</b>
        </div>
    </section>
</div>
