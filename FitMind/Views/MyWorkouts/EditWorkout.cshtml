@model WorkoutManageVm
@{
    ViewData["Title"]="Редактировать тренировку";
}
<a class="back" asp-action="Details" asp-route-id="@Model.Id">← К тренировке</a>
<div class="page-head">
    <h1>Редактировать тренировку</h1>
</div>
<form method="post" asp-action="EditWorkout" class="panel" id="workout-editor">
    <input asp-for="Id" type="hidden"/>
    <div asp-validation-summary="All" class="validation">
    </div>
    <label>Название<input asp-for="Name" required maxlength="160"/>
</label>
<label>Описание<textarea asp-for="Note" maxlength="2000"></textarea></label>
<label>Длительность, мин<input asp-for="Duration" type="number" min="1" max="1440"/>
</label>
<h2>Упражнения</h2>
<p class="muted">Порядок блоков задаёт порядок упражнений. При сохранении подходы заменяются заданными параметрами.</p>
<div id="workout-lines">
    @for(int i=0;i<Model.Lines.Count;i++){var l=Model.Lines[i];<section class="exercise-editor">
    <label>Упражнение<select name="Lines[@i].ExerciseId" required>
    @foreach(var e in Model.Catalog){
        <option value="@e.Id" selected="@(l.ExerciseId==e.Id)">@(e.OwnerId!=null?"Моё · ":"")@e.Name</option>
    }
</select>
</label>
<div class="grid">
    <label>Подходы<input type="number" name="Lines[@i].Sets" value="@l.Sets" min="1" max="30" required/>
</label>
<label>Повторения<input type="number" name="Lines[@i].Reps" value="@l.Reps" min="0" max="1000"/>
</label>
<label>Вес, кг<input type="number" step="0.1" name="Lines[@i].Weight" value="@l.Weight?.ToString(System.Globalization.CultureInfo.InvariantCulture)" min="0" max="2000"/>
</label>
<label>Секунды<input type="number" name="Lines[@i].Seconds" value="@l.Seconds" min="0" max="32767"/>
</label>
</div>
<div class="actions">
    <button type="button" class="ghost" data-line-up>Выше</button>
    <button type="button" class="ghost" data-line-down>Ниже</button>
    <button type="button" class="danger" data-line-delete>Убрать упражнение</button>
</div>
</section>
}
</div>
<div class="form-actions">
    <button type="button" id="add-workout-line" class="ghost">Добавить упражнение</button>
    <button class="primary" type="submit">Сохранить</button>
</div>
</form>
<template id="workout-line-template">
    <section class="exercise-editor">
        <label>Упражнение<select name="Lines[0].ExerciseId" required>
        @foreach(var e in Model.Catalog){
            <option value="@e.Id">@(e.OwnerId!=null?"Моё · ":"")@e.Name</option>
        }
    </select>
</label>
<div class="grid">
    <label>Подходы<input name="Lines[0].Sets" type="number" value="3" min="1" max="30" required/>
</label>
<label>Повторения<input name="Lines[0].Reps" type="number" value="10" min="0" max="1000"/>
</label>
<label>Вес, кг<input name="Lines[0].Weight" type="number" step="0.1" min="0" max="2000"/>
</label>
<label>Секунды<input name="Lines[0].Seconds" type="number" min="0" max="32767"/>
</label>
</div>
<div class="actions">
    <button type="button" class="ghost" data-line-up>Выше</button>
    <button type="button" class="ghost" data-line-down>Ниже</button>
    <button type="button" class="danger" data-line-delete>Убрать упражнение</button>
</div>
</section>
</template>
@section Scripts{<script>
(()=>{const list=document.querySelector('#workout-lines');function names(){[...list.children].forEach((row,i)=>row.querySelectorAll('[name]').forEach(el=>el.name=el.name.replace(/Lines\[\d+\]/,`Lines[${i}]`)));}document.querySelector('#add-workout-line').onclick=()=>{if(list.children.length>=50)return;list.append(document.querySelector('#workout-line-template').content.cloneNode(true));names();};list.addEventListener('click',e=>{const row=e.target.closest('.exercise-editor');if(!row)return;if(e.target.matches('[data-line-delete]'))row.remove();if(e.target.matches('[data-line-up]')&&row.previousElementSibling)list.insertBefore(row,row.previousElementSibling);if(e.target.matches('[data-line-down]')&&row.nextElementSibling)list.insertBefore(row.nextElementSibling,row);names();});})();
</script>}
